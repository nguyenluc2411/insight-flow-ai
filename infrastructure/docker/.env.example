# =============================================================================
# .env.example — mẫu biến môi trường cho docker compose (copy thành .env trên EC2)
# Chỉ liệt kê phần liên quan EMAIL/HÓA ĐƠN. Giữ nguyên các biến hạ tầng khác bạn đang dùng.
# =============================================================================

# --- SMTP gửi email biên nhận thanh toán (notification-service) ---
# Mặc định (bỏ trống) = gửi vào MailHog, KHÁCH KHÔNG NHẬN ĐƯỢC.
# Điền Gmail App Password để gửi thật (xem docs/EMAIL_INVOICE_SETUP.md):
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-account@gmail.com
MAIL_PASS=your-16-char-app-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_SMTP_SSL_TRUST=smtp.gmail.com
MAIL_FROM=your-account@gmail.com

# --- (tùy chọn) Thông tin bên bán in trên biên nhận ---
INVOICE_COMPANY_NAME=Insight Flow AI
INVOICE_COMPANY_ADDRESS=
INVOICE_COMPANY_TAX_CODE=
INVOICE_SUPPORT_EMAIL=support@insightflow.ai
INVOICE_SUPPORT_HOTLINE=
INVOICE_WEBSITE=https://insightflow.ai
